# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only secrets. Never expose these in client code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional admin login overrides. Use ADMIN_PASSWORD_HASH, not the plaintext password.
ADMIN_USERNAME="rjb4200"
ADMIN_PASSWORD_HASH="SHA256_HASH_OF_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="LONG_RANDOM_SESSION_SIGNING_SECRET"

# Daily email reports. Server-only secrets must not be exposed in client code.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="checksheets@example.com"
DAILY_REPORT_TIMEZONE="America/New_York"
DAILY_REPORT_SEND_HOUR="10"
CRON_SECRET="LONG_RANDOM_CRON_SECRET"

# Optional daily report email settings
DAILY_REPORT_REPLY_TO=""
DAILY_REPORT_SUBJECT_PREFIX=""
