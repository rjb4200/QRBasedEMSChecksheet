{
  "name": "EMS Missed Checkoff Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "name": "09:00 Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{$env.APP_URL}}/api/alerts/incomplete-units",
        "options": {}
      },
      "name": "Fetch Incomplete Units",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.shouldSend}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Should Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "fromEmail": "alerts@winchesterky.com",
        "toEmail": "={{$env.ADMIN_ALERT_EMAILS}}",
        "subject": "={{$json.email.subject}}",
        "text": "={{$json.email.text}}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [660, -100]
    }
  ],
  "connections": {
    "09:00 Schedule": {
      "main": [[{"node": "Fetch Incomplete Units", "type": "main", "index": 0}]]
    },
    "Fetch Incomplete Units": {
      "main": [[{"node": "Should Send?", "type": "main", "index": 0}]]
    },
    "Should Send?": {
      "main": [[{"node": "Send Email", "type": "main", "index": 0}], []]
    }
  },
  "settings": {
    "timezone": "America/New_York"
  }
}
